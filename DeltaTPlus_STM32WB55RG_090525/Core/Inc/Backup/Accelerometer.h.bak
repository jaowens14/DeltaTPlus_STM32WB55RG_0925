#ifndef ACCELEROMETER_HPP
#define ACCELEROMETER_HPP

#include "i2c.h"
#include "usart.h"
#include "main.h"

#define ADXL343_ADDR (0x53 << 1) // Correct 8-bit address for grounded ALT_ADDRESS

volatile int delay = 0;
volatile int readDelay = 0;

enum accelerometerStates
{
    INACTIVE,
    ACTIVE
};

accelerometerStates accelerometerState = ACTIVE;

void setupAccelerometer(void);
void accelerometer_handler(void);

int32_t activityThreshold = 75000; // find this
uint32_t idleTime = 15;            // seconds
int32_t acceleration = 0;          // return max from sensor

uint8_t powerCtl = 0x08;
uint8_t accreg = 0x32; // Start from DATAX0
uint8_t accdata[6];

uint8_t int_enable_register = 0x2E; // write 0010 0000 enables double_tap int
uint8_t int_map_register = 0x2F;    // set to 0010 0000 sends double_tap to int1 pin, everything else to int 2 pin

uint8_t thresh_tap_register = 0x1D;
uint8_t dur_register = 0x21;
uint8_t latent_register = 0x22;
uint8_t window_register = 0x23;
uint8_t tap_axes_register = 0x2A;
uint8_t int_source_register = 0x30;

char accmsg[64];

#endif // ACCELEROMETER_HPP
