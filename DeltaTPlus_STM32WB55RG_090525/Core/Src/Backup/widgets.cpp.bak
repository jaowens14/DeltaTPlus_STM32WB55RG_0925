const int needleCutoffY = 123;
const float innerRadius = 400.0;                   // inner radius for both marks
const float minorOuterRadius = innerRadius + 3.0;  // outer radius for minor marks
const float majorOuterRadius = innerRadius + 10.0; // outer radius for major marks
const float neeldeOuterRadius = 493.0;             // outer radius for needle
const float circleXOffset = 120.0;
const float circleYOffset = 460.0;

const float needleOriginX = 120.0;
const float needleOriginY = 160.0;

