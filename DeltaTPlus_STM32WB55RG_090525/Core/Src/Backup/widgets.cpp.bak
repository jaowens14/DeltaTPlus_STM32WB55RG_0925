  labels();
  // buttons();
}

void point_at_distance(float x0, float y0, float x1, float y1, float distance, float *out_x, float *out_y)
{
  // Calculate the direction vector
  float dx = x1 - x0;
  float dy = y1 - y0;

  // Calculate the length of the line segment
  float length = sqrtf(dx * dx + dy * dy);

  // Normalize the direction vector
  float nx = dx / length;
  float ny = dy / length;

  // Calculate the new point at the given distance
  *out_x = x0 + nx * distance;
  *out_y = y0 + ny * distance;
}

// Function to find two points on a line defined by 4 points, at specified distances
void points_on_line(float x0, float y0, float x1, float y1,
                    float x2, float y2, float x3, float y3,
                    float dist_from_start, float dist_from_end,
                    float *p1_x, float *p1_y, float *p2_x, float *p2_y)
{
  // Calculate total line length (sum of both segments)
  float dx1 = x1 - x0;
  float dy1 = y1 - y0;
  float len1 = sqrtf(dx1 * dx1 + dy1 * dy1);

  float dx2 = x3 - x2;
  float dy2 = y3 - y2;
  float len2 = sqrtf(dx2 * dx2 + dy2 * dy2);

  float total_length = len1 + len2;

  // Point 1: distance from start (x0, y0)
  if (dist_from_start <= len1)
  {
    // Point is on first segment
    point_at_distance(x0, y0, x1, y1, dist_from_start, p1_x, p1_y);
  }
  else
  {
    // Point is on second segment
    point_at_distance(x2, y2, x3, y3, dist_from_start - len1, p1_x, p1_y);
  }

  // Point 2: distance from end (x3, y3) going backwards
  if (dist_from_end <= len2)
  {
    // Point is on second segment (going backwards from x3,y3)
    point_at_distance(x3, y3, x2, y2, dist_from_end, p2_x, p2_y);
  }
  else
  {
    // Point is on first segment (going backwards)
    point_at_distance(x1, y1, x0, y0, dist_from_end - len2, p2_x, p2_y);
  }
}
