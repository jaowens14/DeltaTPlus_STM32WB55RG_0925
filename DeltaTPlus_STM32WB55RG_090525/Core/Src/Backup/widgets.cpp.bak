/* Timer callback to update the text area with sensor data */
void updateSettingLabel(void)
{

  const char *switchState;

  if (accelSwitchState)
  {
    switchState = "HIGH";
    // Thermocouples::userGain = 2.0;
  }
  else
  {
    switchState = "LOW";
    // Thermocouples::userGain = 1.0;
  }

  // lv_obj_t *ta = (lv_obj_t *)lv_timer_get_user_data(timer);

  char buf[32];
  snprintf(buf, sizeof(buf), "%s", switchState);

  lv_label_set_text(settingLabel, buf);
}

void updateBatteryLabel(lv_timer_t *timer)
{

  int batteryLevel = getChargeLevel();

  lv_obj_t *ta = (lv_obj_t *)lv_timer_get_user_data(timer);

  char buf[32];
  snprintf(buf, sizeof(buf), "%d%%", batteryLevel);

  lv_label_set_text(ta, buf);
}

void updateNeedle(void)
{
  temperatureAngle = int(myThermocouples.deltaTemp);
  // temperatureAngle = 270;
  if (temperatureAngle != lastTemperatureAngle)
  {
    if (temperatureAngle < startAngle)
      temperatureAngle = startAngle;

    if (temperatureAngle > endAngle)
      temperatureAngle = endAngle;

    lastTemperatureAngle = temperatureAngle;

    float temperatureRadians = temperatureAngle * M_PI / 180.0f;

    // Calculate outer point (on the outer radius)
    float abs_x0 = roundf(circleXOffset + majorOuterRadius * cosf(temperatureRadians));
    float abs_y0 = roundf(circleYOffset + majorOuterRadius * sinf(temperatureRadians));

    // Calculate inner point (on the inner radius)
    float abs_x1; //= roundf(circleXOffset + (innerRadius-50) * cosf(temperatureRadians));
    float abs_y1; // = roundf(circleYOffset + (innerRadius-50) * sinf(temperatureRadians));

    point_at_distance(abs_x0, abs_y0, needleOriginX, needleOriginY, 100, &abs_x1, &abs_y1);

    abs_y1 = 140;

    // Find bounding box
    float min_x = (abs_x0 < abs_x1) ? abs_x0 : abs_x1;
    float min_y = (abs_y0 < abs_y1) ? abs_y0 : abs_y1;
    float max_x = (abs_x0 > abs_x1) ? abs_x0 : abs_x1;
    float max_y = (abs_y0 > abs_y1) ? abs_y0 : abs_y1;

    // Ensure minimum size for bounding box
    if (max_x == min_x)
      max_x = min_x + 1;
    if (max_y == min_y)
      max_y = min_y + 1;

    static lv_point_precise_t needle_points[2];

    // Convert to relative coordinates from the min point
    needle_points[0].x = abs_x0 - min_x;
    needle_points[0].y = abs_y0 - min_y;
    needle_points[1].x = abs_x1 - min_x;
    needle_points[1].y = abs_y1 - min_y;

    lv_line_set_points(needle, needle_points, 2);

    // Get parent container position and subtract it
    lv_obj_t *parent = lv_obj_get_parent(needle);
    lv_coord_t parent_x = lv_obj_get_x(parent);
    lv_coord_t parent_y = lv_obj_get_y(parent);

    // Position relative to container
    lv_obj_set_pos(needle, min_x - parent_x, min_y - parent_y);
  }
}

// Callback function for button click
void menu_button_event_cb(lv_event_t *e)
{
  lv_event_code_t code = lv_event_get_code(e);
  if (code == LV_EVENT_CLICKED)
  {
    LV_LOG_USER("Menu button clicked");
    // Add your menu action here
  }
}

void create_menu_icon_button(lv_obj_t *parent)
{
  // Create the button
  lv_obj_t *btn = lv_btn_create(parent);
  lv_obj_set_size(btn, 60, 20);
  lv_obj_align(btn, LV_ALIGN_BOTTOM_MID, 10, -30);

  // Style the button
  lv_obj_set_style_radius(btn, 8, 0);
  lv_obj_set_style_bg_color(btn, lv_color_hex(0x2196F3), 0);
  lv_obj_set_style_shadow_width(btn, 10, 0);
  lv_obj_set_style_shadow_color(btn, lv_color_hex(0x000000), 0);
  lv_obj_set_style_shadow_opa(btn, LV_OPA_30, 0);

  // Add hover effect
  lv_obj_set_style_bg_color(btn, lv_color_hex(0x1976D2), LV_STATE_PRESSED);

  // Create a label with hamburger menu icon (using text symbol)
  lv_obj_t *label = lv_label_create(btn);
  lv_label_set_text(label, LV_SYMBOL_LIST); // Hamburger menu icon
  lv_obj_center(label);

  // Set font size for the icon
  lv_obj_set_style_text_font(label, &lv_font_montserrat_14, 0);

  // Add event callback
  lv_obj_add_event_cb(btn, menu_button_event_cb, LV_EVENT_CLICKED, NULL);
}

