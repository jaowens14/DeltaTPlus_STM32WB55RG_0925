}

void thermocouplesMain(void)
{
    /* Check if data is ready (set in external interrupt) */
    if (ad7124_rdy_flag)
    {
        HAL_NVIC_DisableIRQ(AD7124_Handler.IRQn); // Temporarily disable interrupt

        /* Optional: check for errors */
        status[1U] = AD7124_ErrorCheck(&AD7124_Handler, &ad7124_error);
        if (status[1U] == AD7124_OK && ad7124_error != 0)
        {
            snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER),
                     "ADC Error Register: 0x%08lX\r\n", (unsigned long)ad7124_error);
            HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
        }

        /* Read conversion results from ADC */
        status[2U] = AD7124_ReadSampleData(&AD7124_Handler);

        if (status[2U] == AD7124_OK)
        {
            // CORRECT voltage conversion for bipolar mode:
            // Formula: V = (Code / 2^23) * (Vref / PGA)
            // Where Code is a SIGNED 24-bit value from -8388608 to +8388607

            // Convert to volts first
            double voltage_ch0_V = ((double)AD7124_ChannelSamples[0] / ADC_RESOLUTION_24BIT) * (ADC_VREF / ADC_PGA_CH0);
            double voltage_ch1_V = ((double)AD7124_ChannelSamples[1] / ADC_RESOLUTION_24BIT) * (ADC_VREF / ADC_PGA_CH1);

            // Convert to millivolts for easier reading
            voltage_ch0_mV = voltage_ch0_V * 1000.0;
            voltage_ch1_mV = voltage_ch1_V * 1000.0;

            // Debug output - show raw codes and voltages
            snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER),
                     "CH0: %+.4f , CH1: %+.4f\r\n",
                     voltage_ch0_mV,
                     voltage_ch1_mV);
            HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);

            // Check for saturation
            if (AD7124_ChannelSamples[0] >= 8388607 || AD7124_ChannelSamples[0] <= -8388608)
            {
                snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "WARNING: CH0 SATURATED!\r\n");
                HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
            }
            if (AD7124_ChannelSamples[1] >= 8388607 || AD7124_ChannelSamples[1] <= -8388608)
            {
                snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "WARNING: CH1 SATURATED!\r\n");
                HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
            }
        }
        else
        {
            snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "Read Error: %d\r\n", status[2U]);
            HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
        }

        ad7124_rdy_flag = 0U;                    // Clear ready flag
        HAL_NVIC_EnableIRQ(AD7124_Handler.IRQn); // Re-enable interrupt
    }

    // lf.measurement = voltage[0]; // voltage
    // rf.measurement = voltage[1]; // voltage
