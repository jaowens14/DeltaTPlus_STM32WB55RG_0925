// External driver structures and buffers
extern AD7124_ConfigTypeDef AD7124_Handler;
extern int32_t AD7124_ChannelSamples[AD7124_ENABLED_CHANNELS];
extern AD7124_RegisterTypeDef configA;

// ADC configuration constants
#define ADC_RESOLUTION_24BIT 8388608.0 // 2^23 for bipolar mode
#define ADC_VREF 2.5                   // Internal reference voltage
#define ADC_PGA_CH0 128.0              // PGA gain for channels 0 and 1
#define ADC_PGA_CH1 128.0

// Status array for tracking return values from driver functions
AD7124_StatusTypeDef status[3U];

// Flag for DOUT/RDY interrupt
volatile uint8_t ad7124_rdy_flag = 0U;

// Variables for error status, voltage, and temperature calculation
int32_t ad7124_error = 0U;
double voltage;
float temperature;

void thermocouplesSetup()
{

    AD7124_Handler.SPIx = &hspi2;             // SPI peripheral used
    AD7124_Handler.csPort = ADC_CS_GPIO_Port; // GPIO port for CS
    AD7124_Handler.csPin = ADC_CS_Pin;        // GPIO pin for CS
    AD7124_Handler.IRQn = ADC_DRDY_EXTI_IRQn; // External interrupt line connected to DOUT/RDY

    HAL_NVIC_DisableIRQ(AD7124_Handler.IRQn); // Disable IRQ during initial config

    // Reset the ADC first
    status[0U] = AD7124_Reset(&AD7124_Handler, 1000);
    if (status[0U] != AD7124_OK)
    {
        // Handle error - maybe retry or report via UART
        snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "ADC Reset Failed!\r\n");
        HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
    }

    // Configure the AD7124
    status[1U] = AD7124_Config(&AD7124_Handler, &configA);
    if (status[1U] != AD7124_OK)
    {
        snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "ADC Config Failed!\r\n");
        HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);
    }

    HAL_NVIC_EnableIRQ(AD7124_Handler.IRQn); // Re-enable interrupt after initialization

    // Allow settling time
    HAL_Delay(200);

    snprintf((char *)UART_BUFFER, sizeof(UART_BUFFER), "ADC Initialized Successfully\r\n");
    HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 100);

    //   rf.error = 0.0f;
