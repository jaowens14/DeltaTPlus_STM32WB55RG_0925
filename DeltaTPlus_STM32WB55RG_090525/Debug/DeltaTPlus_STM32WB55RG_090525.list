** Function name:           Touch_FT5436_IRQHandler
** Description:             Interrupt handler - call this from HAL_GPIO_EXTI_Callback
***************************************************************************************/
void Touch_FT5436_IRQHandler(Touch_FT5436_t *touch, uint16_t GPIO_Pin)
