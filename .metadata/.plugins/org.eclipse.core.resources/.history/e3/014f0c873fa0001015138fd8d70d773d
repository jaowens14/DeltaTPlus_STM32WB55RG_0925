void Screen::writeCanvasRegion(int x0, int y0, int x1, int y1)
{
    if (tft.inTransaction)
    {
        return;
    }

    // Calculate proper width and height
    int width = x1 - x0 + 1;
    int height = y1 - y0 + 1;
    uint32_t bufferSize = width * height;

    // Allocate buffer that persists until DMA completes
    if (dmaRegionBuffer != nullptr)
    {
        delete[] dmaRegionBuffer;
    }
    dmaRegionBuffer = new uint16_t[bufferSize];

    uint16_t *fullBuffer = canvas.getBuffer();

    // Copy only the needle region from the full canvas
    for (int row = 0; row < height; row++)
    {
        int srcOffset = (y0 + row) * 240 + x0;
        int dstOffset = row * width;
        memcpy(&dmaRegionBuffer[dstOffset], &fullBuffer[srcOffset], width * sizeof(uint16_t));
    }

    tft.writeBufferDMA(x0, y0, x1, y1, dmaRegionBuffer, bufferSize);
}

float Screen::radians(float degrees)
{
    return degrees * M_PI / 180.0f;
}
