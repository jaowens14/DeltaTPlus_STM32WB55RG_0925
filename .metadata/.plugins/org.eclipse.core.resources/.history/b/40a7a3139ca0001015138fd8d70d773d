// 6. Update function
void update_gauge(int32_t value)
{
  // Clamp value to 0-100
  if (value < 0)
    value = 0;
  if (value > 100)
    value = 100;

  // Update arc indicator
  lv_arc_set_value(gauge_arc, value);

  // Update needle angle (-135° to +135° = 270° range)
  // LVGL uses tenths of degrees
  int16_t angle = -1350 + (value * 27); // -1350 to +1350
  lv_obj_set_style_transform_angle(needle_line, angle, 0);

  // Update label
  lv_label_set_text_fmt(value_label, "%d", (int)value);
}

