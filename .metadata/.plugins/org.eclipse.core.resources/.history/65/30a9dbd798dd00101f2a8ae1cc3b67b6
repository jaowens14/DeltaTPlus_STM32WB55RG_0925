/* init commands based on LovyanGFX ST7789 driver */
static const uint8_t init_cmd_list[] = {
    // Hardware reset handled separately in lcd_io_init()

    // Pixel format - 16-bit color (your 0x55 for RGB565)
    ST7789_COLMOD,  1,  0x55,

    // Memory access control - default orientation (your 0x08)
    ST7789_MADCTL,  1,  0x08,

    // Frame rate control (your PORCTRL with 5 bytes)
    ST7789_PORCTRL, 5,  0x05, 0x05, 0x00, 0x33, 0x33,

    // Gate control (your GCTRL)
    ST7789_GCTRL,   1,  0x35,

    // Power settings (matching your sequence exactly)
    ST7789_VCOMS,   1,  0x3F,
    ST7789_LCMCTRL, 1,  0x2C,
    ST7789_VDVVRHEN,1,  0x01,
    ST7789_VRHS,    1,  0x0F,
    ST7789_VDVS,    1,  0x20,
    ST7789_FRCTRL2, 1,  0x01,
    ST7789_PWCTRL1, 2,  0xA4, 0xA1,

    // Additional power commands (your undocumented ones)
    0xE8,           1,  0x03,
    0xE9,           3,  0x09, 0x09, 0x08,

    // Gamma settings (your exact 15-byte sequences)
    ST7789_PVGAMCTRL, 15, 0xD0,0x05,0x09,0x09,0x08,0x14,0x28,0x33,0x3F,0x07,0x13,0x14,0x28,0x30,
    ST7789_NVGAMCTRL, 15, 0xD0,0x05,0x09,0x09,0x08,0x03,0x24,0x32,0x32,0x3B,0x38,0x14,0x13,0x28,0x2F,

    // Invert on (your setting)
    ST7789_INVON,   0,

    // Full screen window (your 240x320)
    ST7789_CASET,   4,  0x00,0x00, 0x00,0xEF,
    ST7789_RASET,   4,  0x00,0x00, 0x01,0x3F,

    // Exit sleep + display on (with delay)
    ST7789_SLPOUT,  0,
    LV_LCD_CMD_DELAY_MS, 120,
    ST7789_DISPON,  0,

    LV_LCD_CMD_EOF
};

/**********************
