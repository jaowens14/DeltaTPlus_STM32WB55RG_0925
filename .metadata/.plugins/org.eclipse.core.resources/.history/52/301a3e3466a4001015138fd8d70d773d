float Thermocouples::thermocoupleVoltageToTemp(float voltage_V, float coldJunctionTemp_C)
{
    // Convert voltage from V to mV
    float voltage_mV = voltage_V * 1000.0f;

    // NIST polynomial coefficients for K-type (0°C to 500°C range)
    // Voltage to temperature conversion
    const float c0 = 0.0f;
    const float c1 = 2.508355e1f;
    const float c2 = 7.860106e-2f;
    const float c3 = -2.503131e-1f;
    const float c4 = 8.315270e-2f;
    const float c5 = -1.228034e-2f;
    const float c6 = 9.804036e-4f;
    const float c7 = -4.413030e-5f;
    const float c8 = 1.057734e-6f;
    const float c9 = -1.052755e-8f;

    float t = c0 + c1*voltage_mV + c2*voltage_mV*voltage_mV +
              c3*voltage_mV*voltage_mV*voltage_mV +
              c4*voltage_mV*voltage_mV*voltage_mV*voltage_mV;
    // Add more terms if needed for higher accuracy

    // Add cold junction compensation
    return t + coldJunctionTemp_C;
}
