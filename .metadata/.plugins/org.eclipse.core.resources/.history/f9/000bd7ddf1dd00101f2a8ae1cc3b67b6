static lv_obj_t *menu_screen = NULL;


// button on meter, loads menu
void meter_button_cb(lv_event_t *e){

	create_menu_screen();

	if (menu_screen != NULL){
		lv_screen_load_anim(menu_screen, LV_SCREEN_LOAD_ANIM_OVER_LEFT, 0, 0, true);
	}
}


void create_menu_screen(void)
{
  // Create menu screen
  menu_screen = lv_obj_create(NULL);
  //lv_obj_remove_style_all(menu_screen);

  // Remove the screen's padding
//  lv_obj_set_style_pad_all(menu_screen, 0, 0);

  lv_obj_t *btn = lv_btn_create(menu_screen);
  //lv_obj_remove_style_all(btn);
  lv_obj_set_pos(btn, 10, 10);
  lv_obj_set_size(btn, 120, 50);
  lv_obj_set_style_bg_color(btn, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_bg_opa(btn, LV_OPA_COVER, 0);
}
