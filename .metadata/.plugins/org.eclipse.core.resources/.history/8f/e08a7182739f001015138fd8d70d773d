#include "lvgl.h"
#include "lvgl_st7789.h"
#include <string.h>

// Draw buffer - 1/10 of screen is a good start
#define DISP_BUF_SIZE (ST7789_WIDTH * ST7789_HEIGHT / 10)

static lv_disp_draw_buf_t draw_buf;
static lv_color_t buf1[DISP_BUF_SIZE];
static lv_disp_drv_t disp_drv;

// Flush callback for LVGL
static void disp_flush(lv_disp_drv_t *disp, const lv_area_t *area, lv_color_t *color_p)
{
    // Wait for any previous DMA transfer
    while (ST7789_IsDMABusy())
        ;

    // Set drawing window
    ST7789_SetWindow(area->x1, area->y1, area->x2, area->y2);

    // Calculate size
    uint32_t size = (area->x2 - area->x1 + 1) * (area->y2 - area->y1 + 1);

    // Send data via DMA
    ST7789_WriteDataDMA((uint8_t *)color_p, size * 2);

    // Tell LVGL we're done (called in DMA complete callback)
    // We'll do this in a non-blocking way
}

// Call this from your SPI DMA complete callback
void lv_port_disp_dma_complete(void)
{
    lv_disp_flush_ready(&disp_drv);
}

void lv_port_disp_init(void)
{
    // Initialize ST7789
    ST7789_Init();

    // Clear screen
    ST7789_FillColor(0x0000);

    // Initialize LVGL draw buffer
    lv_disp_draw_buf_init(&draw_buf, buf1, NULL, DISP_BUF_SIZE);

    // Initialize display driver
    lv_disp_drv_init(&disp_drv);
    disp_drv.hor_res = ST7789_WIDTH;
    disp_drv.ver_res = ST7789_HEIGHT;
    disp_drv.flush_cb = disp_flush;
    disp_drv.draw_buf = &draw_buf;

    lv_disp_drv_register(&disp_drv);
}