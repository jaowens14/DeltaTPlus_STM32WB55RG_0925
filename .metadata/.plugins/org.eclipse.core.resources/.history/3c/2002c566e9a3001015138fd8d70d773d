int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* Configure the peripherals common clocks */
  PeriphCommonClock_Config();

  /* Config code for STM32_WPAN (HSE Tuning must be done before system clock configuration) */
  MX_APPE_Config();

  /* IPCC initialisation */
  MX_IPCC_Init();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_RTC_Init();
  MX_I2C1_Init();
  MX_SPI1_Init();
  MX_SPI2_Init();
  MX_TIM2_Init();
  MX_USART1_UART_Init();
  MX_TIM16_Init();
  MX_RF_Init();
  /* USER CODE BEGIN 2 */

  // MX_APPE_Init();

  HAL_Delay(100);
  MX_USB_Device_Init();
  HAL_Delay(100);

  HAL_TIM_Base_Start_IT(&htim16);
  HAL_NVIC_SetPriority(TIM1_UP_TIM16_IRQn, 0, 0);
  HAL_NVIC_EnableIRQ(TIM1_UP_TIM16_IRQn);
  /* USER CODE END 2 */

  /* Init code for STM32_WPAN */
  MX_APPE_Init();

  myAccelerometer.setup();
  myThermocouples.setup();

  myTouch.setup();

  setupBatteryMonitor();

  // 1. Initialize LVLG early lv_init
  lv_init();
  // 2. Initialize TFT Driver
  ST7789_Init();
  ST7789V_SetRotation(2);
  // ST7789_FillScreen(0xf400);
  //  3. Connect tick interface
  lv_tick_set_cb(HAL_GetTick);
  // 4. Connect display interface
  // 4.a create display
  display1 = lv_display_create(ST7789_WIDTH, ST7789_HEIGHT);
  // 4.b buffers
  lv_display_set_buffers(display1, buffer1, buffer2, sizeof(buffer1), LV_DISPLAY_RENDER_MODE_PARTIAL);
  // 4.c flush callback
  lv_display_set_flush_cb(display1, my_flush_cb);

  brookes_meter();

  myBacklight.setup();

  snprintf((char *)UART_BUFFER, 64, "Setup finished\r\n");
  HAL_UART_Transmit(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER), 300);

  int deltaDirection = 1; // 1 = increasing, -1 = decreasing
  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    loopCounter++; // Increment at start of each iteration

    /* USER CODE END WHILE */
    MX_APPE_Process();

    /* USER CODE BEGIN 3 */
    // only MX_APPE_Process();
    myAccelerometer.stateMachine();
    myBacklight.stateMachine();
    //myThermocouples.stateMachine();

    myThermocouples.deltaTemp += deltaDirection;

    if (myThermocouples.deltaTemp  >= 100) {
        deltaDirection = -1;
    }
    else if (myThermocouples.deltaTemp  <= 0) {
        deltaDirection = 1;
    }


    if (measureFlag)
    {
      measureFlag = 0;
      snprintf((char *)UART_BUFFER, 64, "Main loop: %lu Hz\r\n", loopsPerSecond);
      HAL_UART_Transmit_IT(&huart1, UART_BUFFER, strlen((char *)UART_BUFFER));
    }



    // should run at 20ms / 50fps
    if (run_lv_timer_handler)
    {
    	run_lv_timer_handler = 0;
        lv_timer_handler();  // Run safely from main context
    }


  }
  /* USER CODE END 3 */
}

