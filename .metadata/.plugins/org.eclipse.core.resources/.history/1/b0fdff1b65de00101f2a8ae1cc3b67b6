#include "lvgl.h"
#include "widgets.h"

static lv_obj_t *buttonContainer = NULL;
#include "ST7789.h"
#include <accel.h>
#include "Thermocouples.hpp"
#include "BatteryMonitor.h"

void buttons(lv_obj_t *screen)
{

  buttonContainer = lv_obj_create(screen);
  lv_obj_clear_flag(buttonContainer, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_clear_flag(buttonContainer, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_set_width(buttonContainer, lv_obj_get_width(screen) - 4);
  lv_obj_set_height(buttonContainer, 72);
  lv_obj_set_style_border_width(buttonContainer, 2, 0);
  lv_obj_set_style_border_color(buttonContainer, lv_color_hex(WEB_LIGHT_TAN), 0);
  lv_obj_set_style_bg_color(buttonContainer, lv_color_hex(WEB_LIGHT_TAN), 0);

  lv_obj_set_style_radius(buttonContainer, 5, 0);  // Rounded corners
  lv_obj_set_style_pad_all(buttonContainer, 3, 0); // Padding inside
  lv_obj_align_to(buttonContainer, labelContainer, LV_ALIGN_OUT_BOTTOM_MID, 0, 2);

  // Create the button
  lv_obj_t *left_btn = lv_btn_create(buttonContainer);
  lv_obj_set_size(left_btn, 40, 40);
  lv_obj_align(left_btn, LV_ALIGN_LEFT_MID, 0, 0);

  // Style the button
  lv_obj_set_style_radius(left_btn, 8, 0);
  lv_obj_set_style_bg_color(left_btn, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_shadow_width(left_btn, 10, 0);
  lv_obj_set_style_shadow_color(left_btn, lv_color_hex(0x000000), 0);
  lv_obj_set_style_shadow_opa(left_btn, LV_OPA_30, 0);

  // Add hover effect
  lv_obj_set_style_bg_color(left_btn, lv_color_hex(0x1976D2), LV_STATE_PRESSED);

  // Create a label with hamburger menu icon (using text symbol)
  lv_obj_t *label = lv_label_create(left_btn);
  lv_label_set_text(label, LV_SYMBOL_SETTINGS); // Hamburger menu icon
  lv_obj_center(label);

  // Set font size for the icon
  lv_obj_set_style_text_font(label, &lv_font_montserrat_14, 0);

  // Add event callback
  lv_obj_add_event_cb(left_btn, left_btn_cb, LV_EVENT_CLICKED);
}

