#include "lvgl.h"
#include "widgets.h"
#include "menu.h"

lv_obj_t *menu_screen = NULL;
static lv_obj_t *menuContainer = NULL;
static lv_obj_t *headerLabel = NULL;

// Button event callbacks
void menu_about_cb(lv_event_t *e)
{
    // Load about screen
    load_screen(ABOUT);
}

void menu_meter_cb(lv_event_t *e)
{
    // Load meter screen
    load_screen(METER);
}

void menu_settings_cb(lv_event_t *e)
{
    // Load settings screen
    load_screen(SETTINGS);
}

lv_obj_t *create_menu_screen(void)
{
    // Create menu screen with same style as meter screen
    menu_screen = lv_obj_create(NULL);
    lv_obj_clear_flag(menu_screen, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(menu_screen, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_style_bg_opa(menu_screen, LV_OPA_COVER, 0);
    lv_obj_set_style_bg_color(menu_screen, lv_color_hex(WEB_LIGHT_TAN), 0);

    // Create header label
//    headerLabel = lv_label_create(menu_screen);
//    lv_obj_clear_flag(headerLabel, LV_OBJ_FLAG_CLICKABLE);
//    lv_obj_clear_flag(headerLabel, LV_OBJ_FLAG_SCROLLABLE);
//    lv_label_set_text(headerLabel, " ");
//    lv_obj_set_style_text_font(headerLabel, &lv_font_montserrat_14, 0);
//    lv_obj_set_style_text_color(headerLabel, lv_color_hex(Charcoal), 0);
//    lv_obj_align(headerLabel, LV_ALIGN_TOP_MID, 0, 10);

    // Create container for buttons
    menuContainer = lv_obj_create(menu_screen);
    lv_obj_clear_flag(menuContainer, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_clear_flag(menuContainer, LV_OBJ_FLAG_SCROLLABLE);
    lv_obj_set_width(menuContainer, lv_obj_get_width(menu_screen) - 20);
    lv_obj_set_height(menuContainer, LV_SIZE_CONTENT);
    lv_obj_set_style_border_width(menuContainer, 2, 0);
    lv_obj_set_style_border_color(menuContainer, lv_color_hex(Charcoal), 0);
    lv_obj_set_style_bg_color(menuContainer, lv_color_hex(WEB_LIGHT_TAN), 0);
    lv_obj_set_style_radius(menuContainer, 5, 0);
    lv_obj_set_style_pad_all(menuContainer, 10, 0);
    lv_obj_align(menuContainer, LV_ALIGN_CENTER, 0, 0);

    // Button dimensions
    const int btn_width = 180;
    const int btn_height = 50;
    const int btn_spacing = 15;

    // Create "About" button
    lv_obj_t *about_btn = lv_btn_create(menuContainer);
    lv_obj_set_size(about_btn, btn_width, btn_height);
    lv_obj_set_style_radius(about_btn, 8, 0);
    lv_obj_set_style_bg_color(about_btn, lv_color_hex(Charcoal), 0);
    lv_obj_set_style_shadow_width(about_btn, 10, 0);
    lv_obj_set_style_shadow_color(about_btn, lv_color_hex(0x000000), 0);
    lv_obj_set_style_shadow_opa(about_btn, LV_OPA_30, 0);
    lv_obj_set_style_bg_color(about_btn, lv_color_hex(0x1976D2), LV_STATE_PRESSED);
    lv_obj_align(about_btn, LV_ALIGN_TOP_MID, 0, 0);
    lv_obj_add_event_cb(about_btn, menu_about_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *about_label = lv_label_create(about_btn);
    lv_label_set_text(about_label, "About");
    lv_obj_set_style_text_font(about_label, &lv_font_montserrat_14, 0);
    lv_obj_center(about_label);

    // Create "Meter" button
    lv_obj_t *meter_btn = lv_btn_create(menuContainer);
    lv_obj_set_size(meter_btn, btn_width, btn_height);
    lv_obj_set_style_radius(meter_btn, 8, 0);
    lv_obj_set_style_bg_color(meter_btn, lv_color_hex(Charcoal), 0);
    lv_obj_set_style_shadow_width(meter_btn, 10, 0);
    lv_obj_set_style_shadow_color(meter_btn, lv_color_hex(0x000000), 0);
    lv_obj_set_style_shadow_opa(meter_btn, LV_OPA_30, 0);
    lv_obj_set_style_bg_color(meter_btn, lv_color_hex(0x1976D2), LV_STATE_PRESSED);
    lv_obj_align_to(meter_btn, about_btn, LV_ALIGN_OUT_BOTTOM_MID, 0, btn_spacing);
    lv_obj_add_event_cb(meter_btn, menu_meter_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *meter_label = lv_label_create(meter_btn);
    lv_label_set_text(meter_label, "Meter");
    lv_obj_set_style_text_font(meter_label, &lv_font_montserrat_14, 0);
    lv_obj_center(meter_label);

    // Create "Settings" button
    lv_obj_t *settings_btn = lv_btn_create(menuContainer);
    lv_obj_set_size(settings_btn, btn_width, btn_height);
    lv_obj_set_style_radius(settings_btn, 8, 0);
    lv_obj_set_style_bg_color(settings_btn, lv_color_hex(Charcoal), 0);
    lv_obj_set_style_shadow_width(settings_btn, 10, 0);
    lv_obj_set_style_shadow_color(settings_btn, lv_color_hex(0x000000), 0);
    lv_obj_set_style_shadow_opa(settings_btn, LV_OPA_30, 0);
    lv_obj_set_style_bg_color(settings_btn, lv_color_hex(0x1976D2), LV_STATE_PRESSED);
    lv_obj_align_to(settings_btn, meter_btn, LV_ALIGN_OUT_BOTTOM_MID, 0, btn_spacing);
    lv_obj_add_event_cb(settings_btn, menu_settings_cb, LV_EVENT_CLICKED, NULL);

    lv_obj_t *settings_label = lv_label_create(settings_btn);
    lv_label_set_text(settings_label, "Settings");
    lv_obj_set_style_text_font(settings_label, &lv_font_montserrat_14, 0);
    lv_obj_center(settings_label);

    lv_obj_null_on_delete(&menu_screen);


    return menu_screen;
}

void load_menu_cb(lv_event_t *e)
{
    load_screen(MENU);
}
