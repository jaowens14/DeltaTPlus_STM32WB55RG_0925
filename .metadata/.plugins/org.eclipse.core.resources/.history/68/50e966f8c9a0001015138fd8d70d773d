void lv_example_analog_meter(void)
{
    // Create a container for the meter
    lv_obj_t *meter_container = lv_obj_create(lv_screen_active());
    lv_obj_set_size(meter_container, 220, 220);
    lv_obj_center(meter_container);
    lv_obj_set_style_bg_color(meter_container, lv_color_hex(0x000000), 0);
    lv_obj_set_style_border_width(meter_container, 2, 0);
    lv_obj_set_style_border_color(meter_container, lv_color_hex(0x404040), 0);
    lv_obj_set_style_radius(meter_container, 10, 0);

    // Create background arc (scale background)
    lv_obj_t *bg_arc = lv_arc_create(meter_container);
    lv_obj_set_size(bg_arc, 180, 180);
    lv_obj_center(bg_arc);
    lv_arc_set_rotation(bg_arc, METER_START_ANGLE);
    lv_arc_set_bg_angles(bg_arc, 0, METER_END_ANGLE - METER_START_ANGLE);
    lv_arc_set_value(bg_arc, 0);
    lv_obj_remove_style(bg_arc, NULL, LV_PART_KNOB);
    lv_obj_remove_flag(bg_arc, LV_OBJ_FLAG_CLICKABLE);
    lv_obj_set_style_arc_width(bg_arc, 15, LV_PART_MAIN);
    lv_obj_set_style_arc_color(bg_arc, lv_color_hex(0x303030), LV_PART_MAIN);
    lv_obj_set_style_arc_width(bg_arc, 15, LV_PART_INDICATOR);
    lv_obj_set_style_arc_color(bg_arc, lv_color_hex(0x00FF00), LV_PART_INDICATOR);

    meter_arc = bg_arc;

    // Create tick marks
    for (int i = -25; i <= 25; i += 5)
    {
        float angle_deg = METER_START_ANGLE + ((i - METER_MIN_VALUE) * (METER_END_ANGLE - METER_START_ANGLE)) / (float)METER_RANGE;
        float angle_rad = (angle_deg * 3.14159f) / 180.0f;

        // Calculate tick position
        int radius = 75;
        int tick_x = 110 + (int)(radius * cos(angle_rad));
        int tick_y = 110 + (int)(radius * sin(angle_rad));

        // Create tick mark
        lv_obj_t *tick = lv_obj_create(meter_container);
        lv_obj_set_size(tick, (i % 10 == 0) ? 4 : 2, (i % 10 == 0) ? 12 : 8);
        lv_obj_set_style_bg_color(tick, lv_color_hex(0xFFFFFF), 0);
        lv_obj_set_style_border_width(tick, 0, 0);
        lv_obj_set_style_radius(tick, 0, 0);
        lv_obj_set_pos(tick, tick_x - 1, tick_y - 4);
        lv_obj_set_style_transform_rotation(tick, (int16_t)(angle_deg * 10), 0);
        lv_obj_remove_flag(tick, LV_OBJ_FLAG_CLICKABLE);

        // Add text labels for major ticks
        if (i % 10 == 0)
        {
            int label_radius = 60;
            int label_x = 110 + (int)(label_radius * cos(angle_rad));
            int label_y = 110 + (int)(label_radius * sin(angle_rad));

            lv_obj_t *label = lv_label_create(meter_container);
            lv_label_set_text_fmt(label, "%d", i);
            lv_obj_set_style_text_color(label, lv_color_hex(0xFFFFFF), 0);
            lv_obj_set_style_text_font(label, &lv_font_montserrat_12, 0);
            lv_obj_set_pos(label, label_x - 10, label_y - 8);
        }
    }

    // Create center pivot point
    lv_obj_t *pivot = lv_obj_create(meter_container);
    lv_obj_set_size(pivot, 12, 12);
    lv_obj_set_style_radius(pivot, LV_RADIUS_CIRCLE, 0);
    lv_obj_set_style_bg_color(pivot, lv_color_hex(0xFF0000), 0);
    lv_obj_set_style_border_width(pivot, 0, 0);
    lv_obj_center(pivot);
    lv_obj_remove_flag(pivot, LV_OBJ_FLAG_CLICKABLE);

    // Create needle
    meter_needle = lv_obj_create(meter_container);
    lv_obj_set_size(meter_needle, 3, 70);
    lv_obj_set_style_bg_color(meter_needle, lv_color_hex(0xFF0000), 0);
    lv_obj_set_style_border_width(meter_needle, 0, 0);
    lv_obj_set_style_radius(meter_needle, 2, 0);
    lv_obj_set_pos(meter_needle, 110 - 1, 110 - 70);
    lv_obj_set_style_transform_pivot_x(meter_needle, 1, 0);
    lv_obj_set_style_transform_pivot_y(meter_needle, 70, 0);
    lv_obj_remove_flag(meter_needle, LV_OBJ_FLAG_CLICKABLE);

    // Create value display label
    meter_value_label = lv_label_create(meter_container);
    lv_label_set_text(meter_value_label, "0");
    lv_obj_set_style_text_color(meter_value_label, lv_color_hex(0x00FF00), 0);
    lv_obj_set_style_text_font(meter_value_label, &lv_font_montserrat_20, 0);
    lv_obj_set_pos(meter_value_label, 110 - 15, 150);

    // Set initial value to 0
    meter_set_value(0);
}

// ===== FUNCTION TO UPDATE METER VALUE =====
void meter_set_value(int value)
{
    // Clamp value to range
    if (value < METER_MIN_VALUE) value = METER_MIN_VALUE;
    if (value > METER_MAX_VALUE) value = METER_MAX_VALUE;

    // Calculate needle angle
    float normalized = (value - METER_MIN_VALUE) / (float)METER_RANGE;
    int angle_deg = METER_START_ANGLE + (int)(normalized * (METER_END_ANGLE - METER_START_ANGLE));

    // Update needle rotation
    if (meter_needle != NULL)
    {
        lv_obj_set_style_transform_rotation(meter_needle, angle_deg * 10, 0);
    }

    // Update arc indicator
    if (meter_arc != NULL)
    {
        int arc_value = (int)(normalized * 100);
        lv_arc_set_value(meter_arc, arc_value);
    }

    // Update value label
    if (meter_value_label != NULL)
    {
        lv_label_set_text_fmt(meter_value_label, "%d", value);
    }
}

// ===== FUNCTION TO UPDATE WITH ANIMATION =====
void meter_set_value_animated(int value, uint32_t duration_ms)
{
    // Get current value from label
    int current_value = 0;
    if (meter_value_label != NULL)
    {
        const char *text = lv_label_get_text(meter_value_label);
        current_value = atoi(text);
    }

    // Clamp target value
    if (value < METER_MIN_VALUE) value = METER_MIN_VALUE;
    if (value > METER_MAX_VALUE) value = METER_MAX_VALUE;

    // Calculate angles
    float current_normalized = (current_value - METER_MIN_VALUE) / (float)METER_RANGE;
    float target_normalized = (value - METER_MIN_VALUE) / (float)METER_RANGE;

    int start_angle = METER_START_ANGLE + (int)(current_normalized * (METER_END_ANGLE - METER_START_ANGLE));
    int end_angle = METER_START_ANGLE + (int)(target_normalized * (METER_END_ANGLE - METER_START_ANGLE));

    // Animate needle
    if (meter_needle != NULL)
    {
        lv_anim_t a;
        lv_anim_init(&a);
        lv_anim_set_var(&a, meter_needle);
        lv_anim_set_values(&a, start_angle * 10, end_angle * 10);
        lv_anim_set_duration(&a, duration_ms);
        lv_anim_set_exec_cb(&a, (lv_anim_exec_xcb_t)lv_obj_set_style_transform_rotation);
        lv_anim_start(&a);
    }

    // Animate arc
    if (meter_arc != NULL)
    {
        int start_arc_value = (int)(current_normalized * 100);
        int end_arc_value = (int)(target_normalized * 100);

        lv_anim_t a;
        lv_anim_init(&a);
        lv_anim_set_var(&a, meter_arc);
        lv_anim_set_values(&a, start_arc_value, end_arc_value);
        lv_anim_set_duration(&a, duration_ms);
        lv_anim_set_exec_cb(&a, (lv_anim_exec_xcb_t)lv_arc_set_value);
        lv_anim_start(&a);
    }

    // Update label immediately
    if (meter_value_label != NULL)
    {
        lv_label_set_text_fmt(meter_value_label, "%d", value);
    }
}













