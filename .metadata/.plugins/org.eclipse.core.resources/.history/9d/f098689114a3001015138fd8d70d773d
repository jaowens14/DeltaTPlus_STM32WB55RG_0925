#include "Accelerometer.h"

const uint32_t activityThreshold = 75000; // find this
const uint32_t idleTime = 15;             // seconds
int32_t acceleration = 0;                 // return max from sensor
uint32_t powerCtl = 0x08;
const uint8_t accreg = 0x32; // Start from DATAX0

void accelerometerSetup(void)
{
    // pinMode(0, OUTPUT);
    ACCELEROMETER_STATE = _AWAKE;
    accelerometer_delay = 30; // seconds?
                              // Set MEASURE bit (Bit 3) to enable measurement mode
    HAL_I2C_Mem_Write(&hi2c1, ADXL343_ADDR, 0x2D, I2C_MEMADD_SIZE_8BIT, &powerCtl, 1, 1000);

    accelerometerRead();
}

void accelerometerProcessData(void)
{

    int16_t x = (int16_t)((accdata[1] << 8) | accdata[0]);
    int16_t y = (int16_t)((accdata[3] << 8) | accdata[2]);
    int16_t z = (int16_t)((accdata[5] << 8) | accdata[4]);

    acceleration = (int32_t)x * x + (int32_t)y * y + (int32_t)z * z;
}

void accelerometerLoop(void)
{
    if (!accelerometer_read_delay)
    {
        HAL_StatusTypeDef status = HAL_I2C_Mem_Read_IT(&hi2c1, ADXL343_ADDR, accreg, I2C_MEMADD_SIZE_8BIT, accdata, 6);
        accelerometer_read_delay = 10; // 10ms so 100ms
    }

    switch (ACCELEROMETER_STATE)
    {

    case _AWAKE:

        if (acceleration < activityThreshold && !accelerometer_delay)
        {
            accelerometer_delay = 3; // seconds
            ACCELEROMETER_STATE = _SLEEP;
            BACKLIGHT_STATE = _OFF;
        }
        break;

    case _SLEEP:

        if (acceleration > activityThreshold && !accelerometer_delay)
        {
            accelerometer_delay = 30; // seconds
            ACCELEROMETER_STATE = _AWAKE;
            BACKLIGHT_STATE = _HIGH;
        }

        break;
    default:
        break;
    }
}
