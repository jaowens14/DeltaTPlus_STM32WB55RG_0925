#include "ST7789.h"
#include <accel.h>
#include "Thermocouples.hpp"
#include "BatteryMonitor.h"
#include "menu.h"
#include "meter.h"

typedef enum
{

  METER,
  MENU,
  ABOUT,
  SETTINGS,

} SCREEN_ID_T;

uint8_t draw_buffer1[DRAW_BUFFER_SIZE];
uint8_t draw_buffer2[DRAW_BUFFER_SIZE];

void load_screen(SCREEN_ID_T screen)
{

  switch (screen)
  {

  case METER:

    if (meter_screen == NULL)
    {
      meter_screen = create_meter_screen();
      lv_screen_load_anim(meter_screen, LV_SCREEN_LOAD_ANIM_OVER_BOTTOM, 10, 3, true);
    }

    break;

  case MENU:
    break;

  case ABOUT:
    break;

  case SETTINGS:
    break;
  }
}
