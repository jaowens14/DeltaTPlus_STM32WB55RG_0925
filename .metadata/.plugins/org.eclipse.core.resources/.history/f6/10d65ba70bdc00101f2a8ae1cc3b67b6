// main timer implementation
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
  if (htim == &htim16)
  {
    // 0.1ms timers
    timerCounter++;

    // 1ms
    if ((timerCounter % 10) == 0)
    {
      lv_tick_inc(1);

      if ((timerCounter % 200) == 0)
      {
        run_lv_timer_handler = 1;
      }
    }

    if (myThermocouples.delay)
    {
      myThermocouples.delay--;
    }

    // if (accelDelay)
    // {
    //  myAccelerometer.readDelay--;
    // }

    // 100 ms timers //
    if ((timerCounter % 1000) == 0)
    {
    }

    // 1000 ms timers //
    if ((timerCounter % 10000) == 0)
    {

      loopsPerSecond = loopCounter;
      loopCounter = 0;
      measureFlag = 1; // Signal to print result

      timerCounter = 0;
      if (accelDelay)
      {
        accelDelay--;
      }
    }
    //}
  }
}


