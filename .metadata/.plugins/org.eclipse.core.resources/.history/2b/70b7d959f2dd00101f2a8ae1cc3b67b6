void create_settings_screen(void)
{
  // Create settings screen
  settings_screen = lv_obj_create(NULL);
  lv_obj_set_style_bg_color(settings_screen, lv_color_hex(WEB_LIGHT_TAN), 0);

  // Create container for settings content
  lv_obj_t *settings_container = lv_obj_create(settings_screen);
  lv_obj_set_size(settings_container, ST7789_WIDTH - 20, ST7789_HEIGHT - 20);
  lv_obj_center(settings_container);
  lv_obj_set_style_bg_color(settings_container, lv_color_hex(WEB_LIGHT_TAN), 0);
  lv_obj_set_style_bg_opa(settings_container, LV_OPA_COVER, 0); // ADD THIS

  lv_obj_set_style_border_color(settings_container, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_border_width(settings_container, 2, 0);
  lv_obj_set_style_radius(settings_container, 5, 0);
  lv_obj_set_style_pad_all(settings_container, 15, 0);
  lv_obj_clear_flag(settings_container, LV_OBJ_FLAG_SCROLLABLE);

  // Title
  lv_obj_t *title = lv_label_create(settings_container);
  lv_label_set_text(title, "Settings");
  lv_obj_set_style_text_font(title, &lv_font_montserrat_14, 0);
  lv_obj_set_style_text_color(title, lv_color_hex(Charcoal), 0);
  lv_obj_align(title, LV_ALIGN_TOP_MID, 0, 0);

  // Sensitivity Section
  lv_obj_t *sensitivity_title = lv_label_create(settings_container);
  lv_label_set_text(sensitivity_title, "Thermocouple Sensitivity");

  lv_obj_set_style_text_color(sensitivity_title, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(sensitivity_title, &lv_font_montserrat_14, 0);
  lv_obj_align(sensitivity_title, LV_ALIGN_TOP_LEFT, 5, 35);

  // Sensitivity value label
  lv_obj_t *sensitivity_value = lv_label_create(settings_container);
  char sens_buf[16];
  snprintf(sens_buf, sizeof(sens_buf), "%.2fx", thermocouple_sensitivity);
  lv_label_set_text(sensitivity_value, sens_buf);
  lv_obj_set_style_text_color(sensitivity_value, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(sensitivity_value, &lv_font_montserrat_14, 0);
  lv_obj_align(sensitivity_value, LV_ALIGN_TOP_RIGHT, -5, 35);

  // Sensitivity slider
  lv_obj_t *sensitivity_slider = lv_slider_create(settings_container);
  lv_obj_set_size(sensitivity_slider, 200, 10);
  lv_slider_set_range(sensitivity_slider, 50, 200); // 0.5x to 2.0x
  lv_slider_set_value(sensitivity_slider, (int32_t)(thermocouple_sensitivity * 100), LV_ANIM_OFF);
  lv_obj_set_style_bg_opa(sensitivity_slider, LV_OPA_TRANSP, LV_PART_MAIN);

  lv_obj_set_style_bg_color(sensitivity_slider, lv_color_hex(0xCCCCCC), LV_PART_MAIN);
  lv_obj_set_style_bg_color(sensitivity_slider, lv_color_hex(Charcoal), LV_PART_INDICATOR);
  lv_obj_set_style_bg_color(sensitivity_slider, lv_color_hex(WEB_ORANGE), LV_PART_KNOB);
  lv_obj_align_to(sensitivity_slider, sensitivity_title, LV_ALIGN_OUT_BOTTOM_LEFT, 0, 10);
  lv_obj_add_event_cb(sensitivity_slider, sensitivity_slider_cb, LV_EVENT_VALUE_CHANGED, sensitivity_value);

  // Min/Max labels for sensitivity
  lv_obj_t *sens_min = lv_label_create(settings_container);
  lv_label_set_text(sens_min, "0.5x");
  lv_obj_set_style_text_color(sens_min, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(sens_min, &lv_font_montserrat_12, 0);
  lv_obj_align_to(sens_min, sensitivity_slider, LV_ALIGN_OUT_BOTTOM_LEFT, 0, 5);

  lv_obj_t *sens_max = lv_label_create(settings_container);
  lv_label_set_text(sens_max, "2.0x");
  lv_obj_set_style_text_color(sens_max, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(sens_max, &lv_font_montserrat_12, 0);
  lv_obj_align_to(sens_max, sensitivity_slider, LV_ALIGN_OUT_BOTTOM_RIGHT, 0, 5);

  // Brightness Section
  lv_obj_t *brightness_title = lv_label_create(settings_container);
  lv_label_set_text(brightness_title, "Screen Brightness");
  lv_obj_set_style_text_color(brightness_title, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(brightness_title, &lv_font_montserrat_14, 0);
  lv_obj_align_to(brightness_title, sens_min, LV_ALIGN_OUT_BOTTOM_LEFT, 0, 25);

  // Brightness value label
  lv_obj_t *brightness_value = lv_label_create(settings_container);
  char bright_buf[16];
  snprintf(bright_buf, sizeof(bright_buf), "%d%%", screen_brightness);
  lv_label_set_text(brightness_value, bright_buf);
  lv_obj_set_style_text_color(brightness_value, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(brightness_value, &lv_font_montserrat_14, 0);
  lv_obj_align_to(brightness_value, brightness_title, LV_ALIGN_OUT_RIGHT_MID, 50, 0);

  // Brightness slider
  lv_obj_t *brightness_slider = lv_slider_create(settings_container);
  lv_obj_set_size(brightness_slider, 200, 10);
  lv_slider_set_range(brightness_slider, 10, 100); // 10% to 100%
  lv_slider_set_value(brightness_slider, screen_brightness, LV_ANIM_OFF);
  lv_obj_set_style_bg_color(brightness_slider, lv_color_hex(0xCCCCCC), LV_PART_MAIN);
  lv_obj_set_style_bg_color(brightness_slider, lv_color_hex(Charcoal), LV_PART_INDICATOR);
  lv_obj_set_style_bg_color(brightness_slider, lv_color_hex(WEB_ORANGE), LV_PART_KNOB);
  lv_obj_align_to(brightness_slider, brightness_title, LV_ALIGN_OUT_BOTTOM_LEFT, 0, 10);
  lv_obj_add_event_cb(brightness_slider, brightness_slider_cb, LV_EVENT_VALUE_CHANGED, brightness_value);

  // Min/Max labels for brightness
  lv_obj_t *bright_min = lv_label_create(settings_container);
  lv_label_set_text(bright_min, "10%");
  lv_obj_set_style_text_color(bright_min, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(bright_min, &lv_font_montserrat_12, 0);
  lv_obj_align_to(bright_min, brightness_slider, LV_ALIGN_OUT_BOTTOM_LEFT, 0, 5);

  lv_obj_t *bright_max = lv_label_create(settings_container);
  lv_label_set_text(bright_max, "100%");
  lv_obj_set_style_text_color(bright_max, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(bright_max, &lv_font_montserrat_12, 0);
  lv_obj_align_to(bright_max, brightness_slider, LV_ALIGN_OUT_BOTTOM_RIGHT, 0, 5);

  // Info text
  lv_obj_t *info = lv_label_create(settings_container);
  lv_label_set_text(info, "Settings are applied immediately\nand saved automatically");
  lv_obj_set_style_text_align(info, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_style_text_color(info, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_text_font(info, &lv_font_montserrat_12, 0);
  lv_obj_align(info, LV_ALIGN_CENTER, 0, 40);

  // Back button
  lv_obj_t *back_btn = lv_btn_create(settings_container);
  lv_obj_set_size(back_btn, 100, 40);
  lv_obj_set_style_bg_color(back_btn, lv_color_hex(Charcoal), 0);
  lv_obj_set_style_radius(back_btn, 5, 0);
  lv_obj_align(back_btn, LV_ALIGN_BOTTOM_MID, 0, -5);

  lv_obj_t *back_label = lv_label_create(back_btn);
  lv_label_set_text(back_label, "Back");
  lv_obj_center(back_label);
  lv_obj_set_style_text_color(back_label, lv_color_hex(0xFFFFFF), 0);

  lv_obj_add_event_cb(back_btn, navigation_cb, LV_EVENT_CLICKED, (void *)(intptr_t)SCREEN_METER);
}
