  lv_obj_set_style_text_align(right_25, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_size(right_25, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
  lv_obj_align(right_25, LV_ALIGN_TOP_MID, 100, 10);

  // 25 label left inside gauge container
  left_25 = lv_label_create(gaugeContainer);
  lv_obj_clear_flag(left_25, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_clear_flag(left_25, LV_OBJ_FLAG_SCROLLABLE);
  lv_label_set_text(left_25, "25");
  lv_obj_set_style_text_align(left_25, LV_TEXT_ALIGN_CENTER, 0);
  lv_obj_set_size(left_25, LV_SIZE_CONTENT, LV_SIZE_CONTENT);
  lv_obj_align(left_25, LV_ALIGN_TOP_MID, -100, 10);

#if 1 // major tick marks - ANGULAR SPACING

  const float totalAngle = endAngle - startAngle;
  const int numTicks = 41;
  const float angleStep = totalAngle / (numTicks - 1);

  for (int i = 0; i < numTicks; i++)
  {
    float angle = startAngle + (i * angleStep);
    float angleRad = angle * M_PI / 180.0f;

    float temp_radius = minorOuterRadius;

    if (i % 5 == 0)
    {
      temp_radius = majorOuterRadius;
    }

    // Calculate outer point (on the outer radius)
    float abs_x0 = roundf(circleXOffset + temp_radius * cosf(angleRad));
    float abs_y0 = roundf(circleYOffset + temp_radius * sinf(angleRad));

    // Calculate inner point (on the inner radius)
    // float abs_x1 = roundf(circleXOffset + innerRadius * cosf(angleRad));
    // float abs_y1 = roundf(circleYOffset + innerRadius * sinf(angleRad));

    float abs_x1;
    float abs_y1;

    point_at_distance(abs_x0, abs_y0, needleOriginX, needleOriginY, (temp_radius - innerRadius), &abs_x1, &abs_y1);
    // point_at_distance(abs_x0, abs_y0, abs_x1_target, abs_y1_target, tick_length, &new_x, &new_y);

    // Find bounding box
    float min_x = (abs_x0 < abs_x1) ? abs_x0 : abs_x1;
    float min_y = (abs_y0 < abs_y1) ? abs_y0 : abs_y1;
    float max_x = (abs_x0 > abs_x1) ? abs_x0 : abs_x1;
    float max_y = (abs_y0 > abs_y1) ? abs_y0 : abs_y1;

    // Ensure minimum size for bounding box
    if (max_x == min_x)
      max_x = min_x + 1;
    if (max_y == min_y)
      max_y = min_y + 1;

    // Convert to relative coordinates
    lv_point_precise_t *tickMark = tickPoints[i];
    tickMark[0].x = abs_x0 - min_x;
    tickMark[0].y = abs_y0 - min_y;
    tickMark[1].x = abs_x1 - min_x;
    tickMark[1].y = abs_y1 - min_y;

    tickMarks[i] = lv_line_create(gaugeContainer);
    lv_line_set_points(tickMarks[i], tickMark, 2);
    lv_obj_set_style_line_width(tickMarks[i], 2, 0);
    lv_obj_set_style_line_color(tickMarks[i], lv_color_hex(Charcoal), 0);
    lv_obj_set_style_line_rounded(tickMarks[i], true, 0);

    // Subtract container position to get relative coordinates within container
    lv_obj_set_pos(tickMarks[i], (int)(min_x - container_x), (int)(min_y - container_y));
    lv_obj_set_size(tickMarks[i], (int)(max_x - min_x), (int)(max_y - min_y));
  }
#endif

#if 1 // needle
  needle = lv_line_create(gaugeContainer);

  lv_obj_clear_flag(needle, LV_OBJ_FLAG_CLICKABLE);
  lv_obj_clear_flag(needle, LV_OBJ_FLAG_SCROLLABLE);

  lv_obj_set_style_line_width(needle, 3, 0);
  lv_obj_set_style_line_color(needle, lv_color_hex(WEB_ORANGE), 0);
  lv_obj_set_style_line_rounded(needle, false, 0);

  // Initialize needle at start angle
  lastTemperatureAngle = 270; // Force first update
  updateNeedle();
#endif
}





