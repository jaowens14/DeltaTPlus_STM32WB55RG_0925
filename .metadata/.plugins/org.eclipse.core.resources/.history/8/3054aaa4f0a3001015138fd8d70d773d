/**
 * AD7124 Driver adapted for STM32 HAL
 * Based on epsilonRT library, modified for STM32
 */
#include "ad7124-driver.h"
#include "main.h" // For GPIO pin definitions
#include "spi.h"  // For SPI handle

/* Assume you have these defined in your main.h or somewhere:
 * extern SPI_HandleTypeDef hspi1;  // Your SPI handle
 * #define ADC_CS_GPIO_Port GPIOA
 * #define ADC_CS_Pin GPIO_PIN_4
 */

extern SPI_HandleTypeDef hspi1; // Adjust to your SPI handle name
volatile bool spiBusy = false;
volatile int spiStatus = -1;

/* private functions ======================================================== */
// -----------------------------------------------------------------------------
static inline void
setSS(int ss_pin)
{
  HAL_GPIO_WritePin(ADC_CS_GPIO_Port, ADC_CS_Pin, GPIO_PIN_RESET); // CS active low
}

// -----------------------------------------------------------------------------
static inline void
clearSS(int ss_pin)
{
  HAL_GPIO_WritePin(ADC_CS_GPIO_Port, ADC_CS_Pin, GPIO_PIN_SET); // CS inactive high
}

// -----------------------------------------------------------------------------
static inline void
initSS(int ss_pin)
{
  // GPIO should already be initialized by CubeMX
  // Just ensure CS is high initially
  clearSS(ss_pin);
}

/* internal public functions ================================================ */
// -----------------------------------------------------------------------------
bool Ad7124Driver::init(uint8_t slaveDeviceId, bool lsbFirst,
                        uint32_t clockFreq, uint8_t clockPol, uint8_t clockEdg)
{
  id = slaveDeviceId;
  initSS(id);

  // Store settings (though HAL manages most of this)
  speedMaximum = clockFreq;

  // Note: STM32 HAL SPI is typically configured via CubeMX
  // Ensure your SPI is configured as:
  // - Master mode
  // - 8-bit data size
  // - MSB first (AD7124 requirement)
  // - CPOL = 1, CPHA = 1 (SPI Mode 3) - typical for AD7124
  // - NSS software managed

  return true;
}

int Ad7124Driver::read(uint8_t *data, uint8_t len)
{
  if(spiBusy) return -1; // busy

  setSS(id);
  spiBusy = true;
  spiStatus = -1;

  uint8_t dummy_tx[len];
  for(int i = 0; i < len; i++) dummy_tx[i] = data[i];

  if(HAL_SPI_TransmitReceive_IT(&hspi1, dummy_tx, data, len) != HAL_OK)
  {
    clearSS(id);
    spiBusy = false;
    return -1; // failed to start
  }
  return 0; // started
}

int Ad7124Driver::write(const uint8_t *data, uint8_t len)
{
  if(spiBusy) return -1; // busy

  setSS(id);
  spiBusy = true;
  spiStatus = -1;

  if(HAL_SPI_Transmit_IT(&hspi1, (uint8_t *)data, len) != HAL_OK)
  {
    clearSS(id);
    spiBusy = false;
    return -1; // failed to start
  }
  return 0; // started
}

// -----------------------------------------------------------------------------
int Ad7124Driver::delay(unsigned long ms)
{
  HAL_Delay(ms);
  return 0;
}
